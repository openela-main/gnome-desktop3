+qrcodegen_dep = declare_dependency(
+  link_with: libqrcodegen,
+  include_directories: include_directories('c')
+)
diff --git a/subprojects/qrcodegen.wrap b/subprojects/qrcodegen.wrap
new file mode 100644
index 00000000..9080ca48
--- /dev/null
+++ b/subprojects/qrcodegen.wrap
@@ -0,0 +1,5 @@
+[wrap-git]
+url = https://github.com/nayuki/QR-Code-generator.git
+revision = head
+depth = 1
+patch_directory = qrcodegen
