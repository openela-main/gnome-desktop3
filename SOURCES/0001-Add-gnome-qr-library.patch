From 5b0d028d35bfff54dd68c8b157bf34ac47532c75 Mon Sep 17 00:00:00 2001
From: Joan Torres Lopez <joantolo@redhat.com>
Date: Thu, 27 Nov 2025 18:03:16 +0100
Subject: [PATCH 01/20] meson: Add QR-Code-generator as a subproject

Will be used by next commit to generate QR codes
---
 .gitignore                                     |  1 +
 meson.build                                    |  3 +++
 subprojects/packagefiles/qrcodegen/meson.build | 10 ++++++++++
 subprojects/qrcodegen.wrap                     |  5 +++++
 4 files changed, 19 insertions(+)
 create mode 100644 .gitignore
 create mode 100644 subprojects/packagefiles/qrcodegen/meson.build
 create mode 100644 subprojects/qrcodegen.wrap

diff --git a/.gitignore b/.gitignore
new file mode 100644
index 00000000..97b1a628
--- /dev/null
+++ b/.gitignore
@@ -0,0 +1 @@
+subprojects/qrcodegen
